---
import GithubIcon from "@assets/icons/github.svg";
import LinkedInIcon from "@assets/icons/linkedin.svg";
import EmailIcon from "@assets/icons/email-dark.svg";
---
<div class="socials-container">
    <a href="https://github.com/caleb-fringer">
        <GithubIcon />
    </a>

    <a href="https://linkedin.com/in/caleb-fringer">
        <LinkedInIcon />
    </a>

    <a href="mailto:cfringer98@gmail.com">
        <EmailIcon viewBox="0 -5 20 20" />
    </a>
</div>

<style>
    .socials-container {
        display: flex;
        justify-content: center;
        padding: 16px;
    }
    a {
        padding: 8px;
        margin-inline: 16px;
    }
    svg {
        height: 28px;
        width: 28px;
    }

    @media screen and (min-width: 600px) {
        svg {
            height: 40px;
            width: 40px;
        } 
    }
</style>
