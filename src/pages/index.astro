---
import Layout from '../layouts/Layout.astro';
import Socials from '../components/Socials.astro';
---

<Layout title="Caleb Fringer">
    <main>
        <h1>Caleb Fringer</h1>
        <h2>Software Engineer</h2>
        <Socials />
    </main>
</Layout>

<style>
    main {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
    }
    
    h1 {
        font-size: 4rem;
        padding: 16px 32px;
        margin: 32vh 16px 16px;
    }

    h2 {
        font-size: 1.5rem;
        margin: 0px;
        margin-bottom: 16vh;
    }
</style>
